# /etc/conf.d/sixcoind: config file for /etc/init.d/sixcoind

# Config file location
#sixcoind_CONFIGFILE="/etc/sixcoin/sixcoin.conf"

# What directory to write pidfile to?  (created and owned by $sixcoind_USER)
#sixcoind_PIDDIR="/var/run/sixcoind"

# What filename to give the pidfile
#sixcoind_PIDFILE="${sixcoind_PIDDIR}/sixcoind.pid"

# Where to write sixcoind data (be mindful that the blockchain is large)
#sixcoind_DATADIR="/var/lib/sixcoind"

# User and group to own sixcoind process
#sixcoind_USER="sixcoin"
#sixcoind_GROUP="sixcoin"

# Path to sixcoind executable
#sixcoind_BIN="/usr/bin/sixcoind"

# Nice value to run sixcoind under
#sixcoind_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
sixcoind_OPTS="-disablewallet"

# The timeout in seconds OpenRC will wait for sixcoind to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
sixcoind_SIGTERM_TIMEOUT=60
